# Copy to .env.local and fill in. Everything here is public (it ships to the browser).
# Leave the Supabase values empty to run without accounts.
VITE_API_BASE_URL=http://localhost:5111
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Comma separated; each must be enabled in the Supabase dashboard (Authentication > Providers).
VITE_AUTH_PROVIDERS=google
